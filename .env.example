# Скопируйте в .env и измените при необходимости:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# Порт, на котором открывается сайт (npm run dev / npm run start)
PORT=3000

# Куда слушать: localhost — только с этого компьютера; 0.0.0.0 — с других устройств и VPS
HOSTNAME=localhost

# Публичный адрес сайта (должен совпадать с PORT, если меняете порт)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
