# See https://help.github.com/articles/ignoring-files/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Environment & secrets ---
.env
.env.*
!.env.example
!.env*.example
*.local

# --- Database & dumps ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
/prisma/dev.db
/prisma/*.db
/dumps/
*.sql.gz
*.dump
/data/*.db

# --- Next.js ---
/.next/
/out/
/build
next-env.d.ts

# --- Testing & coverage ---
/coverage
*.lcov
.nyc_output

# --- Logs & debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Production / deploy ---
.vercel
.netlify
.turbo

# --- TypeScript ---
*.tsbuildinfo

# --- IDE & editors ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Misc ---
*.pem
*.key
*.p12
*.crt
.cache/
.temp/
tmp/
temp/
uploads/
public/uploads/

# --- Optional local tooling ---
.eslintcache
.stylelintcache
